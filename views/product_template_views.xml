<odoo>
    <record id="view_product_template_form_inherit_avaliacao" model="ir.ui.view">
        <field name="name">product.template.form.avaliacao</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Avaliação">
                    <group>
                        <field name="x_ponto_por_resistencia"/>
                        <field name="x_ponto_por_durabilidade"/>
                        <field name="x_ponto_por_resistencia_termica"/>
                        <field name="x_ponto_por_resistencia_e_fadiga"/>
                        <field name="x_ponto_por_resistencia_ao_uso_indevido"/>
                        <field name="x_aprovado_avaliacao"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>